{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main OxidizeESP window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "allow-app-info",
    "allow-chip-descriptors",
    "allow-list-ports",
    "allow-list-devices",
    "allow-open-device",
    "allow-close-device",
    "allow-probe-device",
    "allow-reset-device",
    "allow-hold-in-reset",
    "allow-flash-elf",
    "allow-write-bin",
    "allow-read-flash",
    "allow-read-partition-table",
    "allow-erase",
    "allow-checksum-md5",
    "allow-cancel-job",
    "allow-inspect-file",
    "allow-inspect-elf",
    "allow-file-md5",
    "allow-verify-backup",
    "allow-suggest-backup-name",
    "allow-load-partition-table",
    "allow-export-partition-table",
    "allow-preview-image",
    "allow-open-log-folder",
    "allow-save-image",
    "allow-start-monitor",
    "allow-monitor-send",
    "allow-monitor-reset",
    "allow-stop-monitor",
    "allow-save-text-file",
    "allow-get-settings",
    "allow-update-settings",
    "allow-reveal-path"
  ]
}
